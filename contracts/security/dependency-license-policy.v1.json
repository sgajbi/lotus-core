{
  "schema_version": "lotus-core.dependency-license-policy.v1",
  "policy_id": "lotus-core-python-dependency-license-policy",
  "policy_version": "1.0.0",
  "governed_by_issue": "https://github.com/sgajbi/lotus-core/issues/926",
  "posture": "report_only_fail_closed_certification",
  "review_owner": "Lotus Technology Risk and Open Source Governance",
  "approved_single_spdx_expressions": [
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "MIT",
    "MPL-2.0",
    "PSF-2.0"
  ],
  "classifier_mappings": {
    "License :: OSI Approved :: Apache Software License": "Apache-2.0",
    "License :: OSI Approved :: MIT License": "MIT",
    "License :: OSI Approved :: Mozilla Public License 2.0 (MPL 2.0)": "MPL-2.0",
    "License :: OSI Approved :: Python Software Foundation License": "PSF-2.0"
  },
  "legacy_license_mappings": {
    "Apache 2.0": "Apache-2.0",
    "Apache-2.0": "Apache-2.0",
    "BSD 2-Clause License": "BSD-2-Clause",
    "BSD-2-Clause": "BSD-2-Clause",
    "BSD-3-Clause": "BSD-3-Clause",
    "ISC": "ISC",
    "MIT": "MIT",
    "MIT License": "MIT",
    "MIT license": "MIT",
    "MPL-2.0": "MPL-2.0",
    "PSF": "PSF-2.0",
    "PSFL": "PSF-2.0"
  },
  "ambiguous_markers": [
    "Dual License",
    "LGPL with exceptions",
    "License :: OSI Approved",
    "License :: OSI Approved :: BSD License",
    "License :: OSI Approved :: GNU Library or Lesser General Public License (LGPL)"
  ],
  "compound_expression_posture": "review_required",
  "missing_metadata_posture": "blocked",
  "review_cadence_days": 30,
  "certification_rule": "Only one unambiguous approved SPDX expression may certify automatically. Compound, conflicting, generic-family, missing, or unmapped evidence requires explicit governed review; no package-name inference is allowed.",
  "legal_boundary": "This engineering control is not legal advice. It blocks certification when the committed evidence lacks an explicit approved classification."
}
